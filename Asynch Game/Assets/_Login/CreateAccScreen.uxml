<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Root" style="flex-grow: 1; background-color: rgb(255, 255, 255);">
        <ui:VisualElement name="Top_part" style="flex-grow: 1; position: absolute; height: 28px; width: 349px; background-color: rgba(134, 133, 133, 0.502);">
            <ui:Label text="Create Account" name="Text_CreateACC" style="position: absolute; top: -9px; left: 1px; width: 341px; -unity-text-align: upper-center; font-size: 20px; -unity-font-style: bold;"/>
        </ui:VisualElement>
        <ui:VisualElement name="Middle_part" style="flex-grow: 1; position: absolute; height: 297px; width: 332px; top: 28px; left: 13px;">
            <ui:TextField label="Username" placeholder-text="Enter your username.." name="Username_textfield" style="position: absolute; top: 1px; left: -1px; flex-direction: column; height: 69px; width: 303px; -unity-font-style: bold;"/>
            <ui:TextField label="Email" placeholder-text="Enter your email..." name="Email_Textfield" style="position: absolute; top: 74px; left: -1px; flex-direction: column; height: 73px; width: 298px; -unity-font-style: bold;"/>
            <ui:TextField label="Password" placeholder-text="Enter your password..." name="Password_TextField" style="position: absolute; top: 154px; left: 0; flex-direction: column; height: 73px; width: 298px; -unity-font-style: bold;"/>
            <ui:TextField label="Confirm password" placeholder-text="Confirm your password..." name="ConfirmPassword_TextField" style="position: absolute; top: 221px; left: 3px; flex-direction: column; height: 73px; width: 298px; -unity-font-style: bold;"/>
        </ui:VisualElement>
        <ui:VisualElement name="Bottom_part" style="flex-grow: 1; width: 337px; position: absolute; height: 133px; top: 314px; left: 6px;">
            <ui:Button text="Submit" name="Button_Submit" style="position: absolute; top: 20px; left: 42px; height: 40px; width: 124px;"/>
            <ui:HelpBox text="Error Message will appear here" style="position: absolute; top: 75px; left: 4px; width: 330px;"/>
            <ui:Button text="Back" name="Button_back" style="position: absolute; top: 21px; left: 177px; height: 40px; width: 124px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
