.root {
	flex-grow: 1;
	justify-content: center;
	align-items: center;
}

.main-panel {
	width: 800px;
	height: 400px;
	background-color: grey;
}

.player-list-scroll-view {
	flex-grow: 1;
	flex-shrink: 1;
}

.row {
	flex-direction: row;
	margin: 5px;
	background-color: dimgray;
}

.row Label {
	width: 250px;
}

.refresh-button {
	width: 100px;
	height: 30px;
	flex-shrink: 0;
	align-self: center;
}